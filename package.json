{
  "name": "chengjing",
  "version": "0.9.4",
  "private": true,
  "author": "Techtarian",
  "description": "澄境 ChengJing — 本機優先的繁體中文視覺筆記與 AI 研究桌面應用",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-transformers-gemma4.mjs",
    "predev": "node scripts/prepare-google-oauth.mjs && node scripts/patch-transformers-gemma4.mjs && node scripts/copy-ort-assets.mjs && node scripts/build-hotkey-helper.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "prebuild": "node scripts/patch-transformers-gemma4.mjs && node scripts/copy-ort-assets.mjs && node scripts/build-hotkey-helper.mjs",
    "build": "tsc -b && vite build && node scripts/verify-built-gemma4-patch.mjs",
    "start": "electron .",
    "dist:dir": "node scripts/prepare-google-oauth.mjs --required && npm run icons && npm run build && electron-builder --dir",
    "dist:mac": "node scripts/prepare-google-oauth.mjs --required && npm run icons && npm run build && electron-builder --mac dmg",
    "dist:win": "node scripts/prepare-google-oauth.mjs --required && npm run icons && npm run build && electron-builder --win --dir --x64 && node scripts/build-windows-installer.mjs x64 && electron-builder --win --dir --arm64 && node scripts/build-windows-installer.mjs arm64",
    "dist:win:x64": "node scripts/prepare-google-oauth.mjs --required && npm run icons && npm run build && electron-builder --win --dir --x64 && node scripts/build-windows-installer.mjs x64",
    "dist:win:arm64": "node scripts/prepare-google-oauth.mjs --required && npm run icons && npm run build && electron-builder --win --dir --arm64 && node scripts/build-windows-installer.mjs arm64",
    "pretest": "node scripts/patch-transformers-gemma4.mjs",
    "test": "node scripts/patch-transformers-gemma4.mjs --check && vitest run src --environment jsdom && node --test electron/*.node.cjs",
    "qa": "node scripts/qa.mjs",
    "qa:functional": "node scripts/qa-functional.mjs",
    "qa:regressions": "node scripts/qa-regressions.mjs",
    "qa:typography": "node scripts/qa-typography.mjs",
    "qa:responsive": "node scripts/qa-responsive.mjs",
    "qa:navigation-readiness": "node scripts/qa-navigation-readiness.mjs",
    "qa:board": "node scripts/qa-board.mjs",
    "qa:board-kanban": "node scripts/qa-board-kanban.mjs",
    "qa:installed-board-kanban": "node scripts/qa-installed-board-kanban.mjs",
    "qa:global-capture": "node scripts/qa-global-capture.mjs",
    "qa:menu-bar": "node scripts/qa-menu-bar.mjs",
    "qa:second-brain": "node scripts/qa-second-brain.mjs",
    "qa:database-share": "node scripts/qa-database-share.mjs",
    "qa:pinned-cards": "node scripts/qa-pinned-cards.mjs",
    "qa:journal-polish": "node scripts/qa-journal-polish.mjs",
    "qa:board-ime-security": "node scripts/qa-board-ime-security.mjs",
    "qa:frameless-themes": "node scripts/qa-frameless-themes.mjs",
    "qa:i18n": "node scripts/qa-i18n.mjs",
    "qa:update": "node scripts/qa-update.mjs",
    "qa:live-update-bridge": "node scripts/qa-live-update-bridge.mjs",
    "qa:tags": "node scripts/qa-tags.mjs",
    "qa:preferences-tasks": "node scripts/qa-preferences-tasks.mjs",
    "qa:auto-backup": "node scripts/qa-auto-backup.mjs",
    "qa:live-google-backup": "node scripts/prepare-google-oauth.mjs --required && node scripts/qa-live-google-backup.mjs",
    "qa:task-timeline": "node scripts/qa-task-timeline.mjs",
    "qa:task-hierarchy": "node scripts/qa-task-hierarchy.mjs",
    "qa:task-knowledge": "node scripts/qa-task-knowledge.mjs",
    "qa:knowledge-library": "node scripts/qa-knowledge-library.mjs",
    "qa:pdf-viewer": "node scripts/qa-pdf-viewer.mjs",
    "qa:ai-actions": "node scripts/qa-ai-actions.mjs",
    "qa:openrouter-routing": "node scripts/qa-openrouter-routing.mjs",
    "qa:employee-workday": "node scripts/qa-employee-workday.mjs",
    "qa:wish-pool": "node scripts/qa-wish-pool.mjs",
    "qa:wish-pool-live": "node scripts/qa-wish-pool-live.mjs",
    "qa:shared-brain": "node scripts/qa-shared-brain.mjs",
    "qa:scale-architecture": "node scripts/qa-scale-architecture.mjs",
    "qa:content-editing": "node scripts/qa-content-editing.mjs",
    "qa:content-conversions": "node scripts/qa-content-conversions.mjs",
    "qa:windows-ui": "node scripts/qa-windows-ui.mjs",
    "qa:windows-package": "node scripts/qa-windows-package.mjs",
    "qa:installed-data-migration": "node scripts/qa-installed-data-migration.mjs",
    "qa:installed-performance": "node scripts/qa-installed-performance.mjs",
    "qa:local-gemma-runtime": "node scripts/qa-local-gemma-runtime.mjs",
    "qa:live-local-gemma": "node scripts/qa-live-local-gemma.mjs",
    "qa:live-local-brain": "node scripts/qa-live-local-brain.mjs",
    "qa:ai-markdown": "node scripts/qa-ai-markdown.mjs",
    "qa:highlight-theme": "node scripts/qa-highlight-theme.mjs",
    "qa:ai-conversation": "node scripts/qa-ai-conversation.mjs",
    "qa:advanced-integrations": "node scripts/qa-advanced-integrations.mjs",
    "qa:health": "node scripts/qa-health-runtime.mjs",
    "qa:health-suite": "node scripts/qa-health-suite.mjs",
    "smoke:electron": "electron scripts/electron-smoke.cjs",
    "smoke:electron-main": "node scripts/electron-main-smoke.mjs",
    "icons": "node scripts/build-icon.mjs",
    "prepare:ort": "node scripts/copy-ort-assets.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@mozilla/readability": "0.6.0",
    "jsdom": "30.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tiptap/extension-highlight": "3.30.3",
    "@tiptap/extension-task-item": "3.30.3",
    "@tiptap/extension-task-list": "3.30.3",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "@xyflow/react": "12.11.3",
    "concurrently": "10.0.5",
    "dayjs": "1.11.23",
    "dexie": "4.4.5",
    "dexie-react-hooks": "4.4.0",
    "dompurify": "3.4.14",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.2.5",
    "framer-motion": "13.1.1",
    "jszip": "3.10.1",
    "lucide-react": "1.34.0",
    "mammoth": "1.12.1",
    "marked": "18.0.11",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.5",
    "three": "^0.185.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "9.1.0",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "tw.techtarian.chengjing",
    "productName": "澄境",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/@modelcontextprotocol/**/*.map",
      "!node_modules/@modelcontextprotocol/**/*.d.ts",
      "!node_modules/@modelcontextprotocol/**/*.d.cts",
      "!node_modules/@modelcontextprotocol/**/*.d.mts",
      "!node_modules/@modelcontextprotocol/**/*.mjs",
      "!node_modules/zod/src/**/*",
      "!node_modules/zod/v3/**/*",
      "!node_modules/zod/v4-mini/**/*",
      "!node_modules/zod/mini/**/*",
      "!node_modules/zod/**/*.d.ts",
      "!node_modules/zod/**/*.d.cts",
      "!node_modules/zod/**/*.d.mts",
      "!node_modules/zod/**/*.js",
      "!node_modules/@huggingface/transformers/.cache/**/*",
      "!node_modules/@huggingface/transformers/src/**/*",
      "!node_modules/@huggingface/transformers/types/**/*",
      "!node_modules/@huggingface/transformers/dist/transformers.web*",
      "!node_modules/@huggingface/transformers/dist/transformers.js",
      "!node_modules/@huggingface/transformers/dist/transformers.min.js",
      "!node_modules/@huggingface/transformers/dist/*.map",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "build/ChengJingQuickCapture.app",
          "to": "native/ChengJingQuickCapture.app"
        }
      ],
      "target": [
        "dmg"
      ],
      "artifactName": "ChengJing-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "executableName": "ChengJing"
    }
  }
}
